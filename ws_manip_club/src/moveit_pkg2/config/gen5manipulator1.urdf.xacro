<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gen5manipulator1">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import gen5manipulator1 urdf file -->
    <xacro:include filename="$(find gen5manipulator1)/urdf/gen5manipulator1.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="gen5manipulator1.ros2_control.xacro" />


    <xacro:gen5manipulator1_ros2_control name="Gen5Manipulator1" initial_positions_file="$(arg initial_positions_file)"/>

    <gazebo>
        <plugin filename="libign_ros2_control-system.so"
                name="ign_ros2_control::IgnitionROS2ControlPlugin">
            <parameters>$(find moveit_pkg2)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
